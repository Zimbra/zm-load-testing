{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/oauth2/v1/token",
    "bodyPatterns": [
      { "contains": "grant_type=refresh_token" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "token-success.json",
    "fixedDelayMilliseconds": 250
  }
}
