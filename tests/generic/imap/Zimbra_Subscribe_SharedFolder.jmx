              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="BuildMountpointName">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">// Extract just the local part before &quot;@&quot; from sender_username
// Result: mount_name = &quot;mbox1_user23 Sent&quot;

String senderFull = vars.get(&quot;sender_username&quot;)  // e.g. mbox1_user23@domain.com
String localPart  = senderFull.contains(&quot;@&quot;) 
                    ? senderFull.split(&quot;@&quot;)[0]    // → mbox1_user23
                    : senderFull

String mountName  = localPart + &quot; Sent&quot;           // → &quot;mbox1_user23 Sent&quot;
vars.put(&quot;mount_name&quot;, mountName)

log.info(&quot;[PreProcessor] sender_username=&quot; + senderFull 
       + &quot; | mount_name=&quot; + mountName)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
            </hashTree>
