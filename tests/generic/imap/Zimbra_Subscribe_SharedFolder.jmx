        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Wait_For_Sender">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ── Wait_For_Sender JSR223 Sampler ──
// Purpose: Give Sender thread enough time to complete SETACL
// before Recipient attempts CreateMountpoint / Accept Share

int waitTime = props.get(&quot;SHARE_WAIT_TIME&quot;, &quot;5000&quot;).toInteger() // 5 seconds — increase to 10000 for 750 users

log.info(&quot;[RECIPIENT - Wait_For_Sender] Thread: ${ctx.getThreadNum()} | Waiting ${waitTime}ms...&quot;)

Thread.sleep(waitTime)

log.info(&quot;[RECIPIENT - Wait_For_Sender] Thread: ${ctx.getThreadNum()} | Wait complete. Proceeding to Login.&quot;)

// Mark sampler as success
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;Wait ${waitTime}ms completed successfully&quot;)
SampleResult.setLatency(waitTime)</stringProp>
        </JSR223Sampler>
        <hashTree/>
