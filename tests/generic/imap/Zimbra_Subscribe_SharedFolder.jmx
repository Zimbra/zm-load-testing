  &lt;/soapenv:Header&gt;&#xd;
  &lt;soapenv:Body&gt;&#xd;
    &lt;BatchRequest xmlns=&quot;urn:zimbra&quot;&gt;&#xd;
      &lt;AutoCompleteRequest xmlns=&quot;urn:zimbraMail&quot;&gt;&#xd;
        &lt;name&gt;${recipient_username}&lt;/name&gt;&#xd;
      &lt;/AutoCompleteRequest&gt;&#xd;
    &lt;/BatchRequest&gt;&#xd;
  &lt;/soapenv:Body&gt;&#xd;
&lt;/soapenv:Envelope&gt;</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
