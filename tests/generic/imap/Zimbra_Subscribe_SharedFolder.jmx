    &lt;context xmlns=&quot;urn:zimbra&quot;&gt;&#xd;
      &lt;authToken&gt;${ZM_AUTH_TOKEN}&lt;/authToken&gt;&#xd;
      &lt;authTokenControl voidOnExpired=&quot;true&quot;/&gt;&#xd;
