              <stringProp name="609973189">${__groovy(def chars = &apos;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-&apos;; def rnd = java.util.concurrent.ThreadLocalRandom.current(); def p = (1..22).collect { chars[rnd.nextInt(chars.length())] }.join(); def s = (1..134).collect { chars[rnd.nextInt(chars.length())] }.join(); return p + &apos;:APA91b&apos; + s;)}</stringProp>
