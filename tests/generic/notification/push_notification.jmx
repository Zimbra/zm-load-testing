        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="START" enabled="true">
          <stringProp name="BeanShellSampler.query">String server = props.get(&quot;HTTP.server&quot;);
if (server == null) {
    server = props.get(&quot;ZSOAP.server&quot;);
}

String httpPort = props.get(&quot;HTTP.port&quot;);
httpPort = (httpPort != null) ? httpPort.trim() : &quot;443&quot;;

String url = &quot;https://&quot; + server;
if (!httpPort.equals(&quot;&quot;) &amp;&amp; !httpPort.equals(&quot;443&quot;)) {
    url = url + &quot;:&quot; + httpPort;
}
url = url + &quot;/service/soap&quot;;

log.info(&quot;Constructed SOAP URL: &quot; + url);
vars.put(&quot;URL&quot;, url);</stringProp>
          <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
        </BeanShellSampler>
