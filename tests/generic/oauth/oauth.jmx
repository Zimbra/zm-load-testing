            <boolProp name="HTTPSampler.md5">false</boolProp>
            <intProp name="HTTPSampler.ipSourceType">0</intProp>
            <stringProp name="TestPlan.comments">This uses the tokens returned from your previous login (refreshToken and refreshTokenSalt) to renew the session without sending a password.

</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="Auth-Type" elementType="Header">
                  <stringProp name="Header.name">Auth-Type</stringProp>
                  <stringProp name="Header.value">ZM_OAUTH2_1.0</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <BoundaryExtractor guiclass="BoundaryExtractorGui" testclass="BoundaryExtractor" testname="refreshToken" enabled="true">
              <stringProp name="BoundaryExtractor.useHeaders">false</stringProp>
              <stringProp name="BoundaryExtractor.refname">refreshToken</stringProp>
              <stringProp name="BoundaryExtractor.lboundary">&lt;refreshToken&gt;</stringProp>
              <stringProp name="BoundaryExtractor.rboundary">&lt;/refreshToken&gt;</stringProp>
              <stringProp name="BoundaryExtractor.default">NA</stringProp>
              <boolProp name="BoundaryExtractor.default_empty_value">false</boolProp>
