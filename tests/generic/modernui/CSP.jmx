      <hashTree/>
      <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Modern_CSP_NGINX Setup" enabled="true">
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <boolProp name="resetInterpreter">false</boolProp>
        <stringProp name="script">import com.zimbra.jmeter.Zimbra;

// 1. Property retrieval and trimming
String server = props.get(&quot;HTTP.server&quot;);
if (server == null) server = props.get(&quot;ZSOAP.server&quot;);
if (server != null) server = server.trim();

String httpPort = props.get(&quot;HTTP.port&quot;);
httpPort = (httpPort != null) ? httpPort.trim() : &quot;443&quot;;

String adminPort = props.get(&quot;HTTP.admin.port&quot;);
adminPort = (adminPort != null) ? adminPort.trim() : &quot;7071&quot;;

// 2. ZSOAP properties
props.put(&quot;ZSOAP.server&quot;, server);
if (props.get(&quot;ZSOAP.port&quot;) == null) props.put(&quot;ZSOAP.port&quot;, httpPort);

if (props.get(&quot;PROFILE.ZSOAP.type&quot;) == null) {
    props.put(&quot;PROFILE.ZSOAP.type&quot;, &quot;none&quot;);
}

// 3. Zimbra helper (failure is logged, plan continues)
try {
    Zimbra soap = new Zimbra(props, &quot;ZSOAP&quot;);
    vars.putObject(&quot;ZSOAP&quot;, soap);
} catch (Throwable t) {
    log.warn(&quot;Zimbra SOAP helper not initialized: &quot; + t.getMessage());
}

// 4. Build URLs
String baseUrl = &quot;https://&quot; + server;
String adminUrl = baseUrl + &quot;:&quot; + adminPort + &quot;/service/admin/soap&quot;;
String soapUrl = baseUrl;
if (!httpPort.equals(&quot;&quot;) &amp;&amp; !httpPort.equals(&quot;443&quot;)) {
    soapUrl = soapUrl + &quot;:&quot; + httpPort;
}
soapUrl = soapUrl + &quot;/service/soap&quot;;
String modern_url = baseUrl + &quot;/modern/&quot;;

log.info(&quot;Constructed SOAP URL: &quot; + soapUrl);
log.info(&quot;Constructed MODERN UI URL: &quot; + modern_url);

vars.put(&quot;ADMIN&quot;, adminUrl);
vars.put(&quot;URL&quot;, soapUrl);
vars.put(&quot;MODERN_URL&quot;, modern_url);

// Variables referenced by sampler fields
vars.put(&quot;HTTP.server&quot;, server);
vars.put(&quot;HTTP.port&quot;, httpPort);
vars.put(&quot;HTTP.protocol&quot;, &quot;https&quot;);
vars.put(&quot;http.protocol&quot;, &quot;https&quot;);

// 5. Time shift
long now = System.currentTimeMillis();
long startEpoch = now - (5L * 24 * 60 * 60 * 1000);   // -5 days
long endEpoch   = now + (14L * 24 * 60 * 60 * 1000);  // +14 days

vars.put(&quot;searchStartEpochTime&quot;, String.valueOf(startEpoch));
vars.put(&quot;searchEndEpochTime&quot;, String.valueOf(endEpoch));</stringProp>
      </BeanShellPreProcessor>
