            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion: Pre-flight Verification" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def headerNonce = vars.get(&quot;HEADER_NONCE&quot;)
def bodyNonce = vars.get(&quot;BODY_NONCE&quot;)
def responseText = prev.getResponseDataAsString()

log.info(&quot;=== Pre-flight Verification ===&quot;)
log.info(&quot;Extracted Header Nonce: &quot; + headerNonce)
log.info(&quot;Extracted Body Nonce:   &quot; + bodyNonce)

if (headerNonce == null || &quot;NONCE_NOT_FOUND_IN_HEADER&quot;.equals(headerNonce)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Pre-flight FAILED: CSP header missing or nonce is not a 32-character hex token.&quot;)
    return
}

if (bodyNonce == null || &quot;NONCE_NOT_FOUND_IN_BODY&quot;.equals(bodyNonce)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Pre-flight FAILED: &lt;meta name=\&quot;csp-nonce\&quot; content=\&quot;...\&quot;&gt; missing in HTML body.&quot;)
    return
}

if (!headerNonce.equalsIgnoreCase(bodyNonce)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Pre-flight FAILED: Nonce mismatch! Header=[&quot; + headerNonce + &quot;] != Body=[&quot; + bodyNonce + &quot;]&quot;)
    return
}

if (responseText.contains(&quot;__CSP_NONCE__&quot;)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Pre-flight FAILED: NGINX sub_filter did not replace literal &apos;__CSP_NONCE__&apos; placeholder!&quot;)
    return
}

log.info(&quot;Pre-flight SUCCESS: Header and body nonces match perfectly, no placeholder leakage.&quot;)
</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
