                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="FolderSync" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.HttpEntity
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP Request ────────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=FolderSync&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    // ── PolicyKey from props (cross-thread safe) ──────────────────────────
    String policyKey = props.getProperty(&quot;FINAL_POLICY_KEY.${userKey}&quot;, &quot;0&quot;)
    hp.setHeader(&quot;X-MS-PolicyKey&quot;, policyKey)

    // ── FolderSyncKey from props (cross-thread safe) ──────────────────────
    String folderSyncKey = props.getProperty(&quot;FOLDERSYNCKEY.${userKey}&quot;, &quot;0&quot;)
    if (!folderSyncKey) folderSyncKey = &quot;0&quot;
    log.info(&quot;FolderSync: using SyncKey=${folderSyncKey} | PolicyKey=${policyKey} | User=${userKey}&quot;)

    // ── Generate WBXML Request Body ───────────────────────────────────────
    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
               BinarySerializer.FOLDERHIERARCHY_FOLDERSYNC)
      bs.textElement(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
                     BinarySerializer.FOLDERHIERARCHY_SYNCKEY,
                     folderSyncKey)
    bs.closeTag()

    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // ── SSL + Execute ─────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    HttpResponse hr = dhc.execute(hp)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Parse WBXML + Extract Next FolderSyncKey ──────────────────────────
    StringBuilder result = new StringBuilder()
    String nextSyncKey   = &quot;&quot;
    boolean inSyncKey    = false

    try {
        BinaryParser bp = new BinaryParser(
            new ByteArrayInputStream(EntityUtils.toByteArray(hr.getEntity())), false)

        while (bp.next() != null) {
            switch (bp.getEventType()) {
                case BinaryParser.START_DOCUMENT:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.END_DOCUMENT:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.START_TAG:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = true
                    break
                case BinaryParser.END_TAG:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = false
                    break
                case BinaryParser.TEXT:
                    String text = bp.getText()
                    result.append(text)
                    if (inSyncKey &amp;&amp; text?.trim()) {
                        nextSyncKey = text.trim()
                    }
                    break
            }
        }
    } catch (IOException e) {
        if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
    }

    // ── Write next FolderSyncKey to props (cross-thread safe) ─────────────
    if (nextSyncKey) {
        props.put(&quot;FOLDERSYNCKEY.${userKey}&quot;, nextSyncKey)
        vars.put(&quot;FOLDERSYNCKEY&quot;, nextSyncKey)
        log.info(&quot;FolderSync: next SyncKey=${nextSyncKey} | HTTP=${responseCode} | User=${userKey}&quot;)
    } else if (responseCode != 200) {
        log.warn(&quot;FolderSync: no SyncKey in response | HTTP=${responseCode} | PolicyKey sent=${policyKey} | User=${userKey}&quot;)
    }

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-FolderSync&quot;)

} catch (Exception e) {
    log.error(&quot;FolderSync: ${e.toString()}&quot;)
}</stringProp>
