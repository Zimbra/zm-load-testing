        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="ColdAuth_Options" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpOptions
import org.apache.http.HttpResponse
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP OPTIONS Request ────────────────────────────────────────
    HttpOptions ho = new HttpOptions(vars.get(&quot;URL&quot;))

    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    ho.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    ho.setHeader(&quot;User-Agent&quot;, &quot;Apple-iPhone9C1/1604.1&quot;)

    // ── SSL ───────────────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    // ── Execute ───────────────────────────────────────────────────────────
    HttpResponse hr        = dhc.execute(ho)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Capture EAS capability headers ───────────────────────────────────
    String cmds     = &quot;&quot;
    String versions = &quot;&quot;
    for (org.apache.http.Header h : hr.getAllHeaders()) {
        if (&quot;MS-ASProtocolCommands&quot; == h.getName()) cmds     = h.getValue()
        if (&quot;MS-ASProtocolVersions&quot; == h.getName()) versions = h.getValue()
    }

    // ── Store in vars (thread-local) + props (cross-thread) ──────────────
    // props allows downstream samplers in other threads to read EAS version
    // without re-issuing OPTIONS; vars serves same-thread downstream use.
    vars.put(&quot;EAS_SUPPORTED_COMMANDS&quot;, cmds)
    vars.put(&quot;EAS_SUPPORTED_VERSIONS&quot;, versions)
    props.put(&quot;EAS_SUPPORTED_COMMANDS.${userKey}&quot;, cmds)
    props.put(&quot;EAS_SUPPORTED_VERSIONS.${userKey}&quot;, versions)

    // ── Negotiate EAS version: prefer 16.1, fall back to 14.1, else 12.1 ─
    // Writes to props[&quot;EAS.version&quot;] so all samplers pick it up via
    // props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;) without any change to them.
    if (versions.contains(&quot;16.1&quot;)) {
        props.put(&quot;EAS.version&quot;, &quot;16.1&quot;)
    } else if (versions.contains(&quot;14.1&quot;)) {
        props.put(&quot;EAS.version&quot;, &quot;14.1&quot;)
    } else {
        props.put(&quot;EAS.version&quot;, &quot;12.1&quot;)
    }

    log.info(&quot;OPTIONS: HTTP=${responseCode} | Versions=${versions} | NegotiatedVersion=${props.getProperty(&apos;EAS.version&apos;)} | User=${userKey}&quot;)

    dhc.close()
    SampleResult.setResponseData(&quot;Commands: ${cmds}\nVersions: ${versions}&quot;, &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-OPTIONS&quot;)

} catch (Exception e) {
    log.error(&quot;OPTIONS: ${e.toString()}&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="ColdAuth_Provision" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Phase 1: Get Policy ───────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=Provision&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
      bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
        bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
          bs.textElement(BinarySerializer.NAMESPACE_PROVISION,
                         BinarySerializer.PROVISION_POLICYTYPE,
                         &quot;MS-EAS-Provisioning-WBXML&quot;)
        bs.closeTag()
      bs.closeTag()
    bs.closeTag()
    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    SSLContextBuilder sslBuilder = new SSLContextBuilder()
    sslBuilder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        sslBuilder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    // Track MFA latency — this request triggers the MFA flow server-side
    long mfaStart  = System.currentTimeMillis()
    HttpResponse hr = dhc.execute(hp)
    long mfaPhase1 = System.currentTimeMillis() - mfaStart

    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    String policyKey     = &quot;&quot;
    String status        = &quot;&quot;
    StringBuilder result = new StringBuilder()
    byte[] respBytes     = EntityUtils.toByteArray(hr.getEntity())

    if (responseCode == 200 &amp;&amp; respBytes.length &gt; 0) {
        try {
            BinaryParser bp     = new BinaryParser(new ByteArrayInputStream(respBytes), false)
            boolean inPolicyKey = false
            boolean inStatus    = false
            while (bp.next() != null) {
                switch (bp.getEventType()) {
                    case BinaryParser.START_TAG:
                        result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = true
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = true
                        break
                    case BinaryParser.END_TAG:
                        result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = false
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = false
                        break
                    case BinaryParser.TEXT:
                        String text = bp.getText()
                        result.append(text)
                        if (inPolicyKey) policyKey = text
                        if (inStatus)    status    = text
                        break
                }
            }
        } catch (IOException e) {
            if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
        }
    } else {
        result.append(new String(respBytes, StandardCharsets.UTF_8))
    }

    vars.put(&quot;PROVISION_POLICY_KEY&quot;, policyKey)
    vars.put(&quot;PROVISION_STATUS&quot;, status)
    vars.put(&quot;MFA_LATENCY_PHASE1_MS&quot;, String.valueOf(mfaPhase1))

    log.info(&quot;Provision Phase1: HTTP=${responseCode} | PolicyKey=${policyKey} | Status=${status} | MFA_Phase1=${mfaPhase1}ms | User=${userKey}&quot;)

    // ── Phase 2: Accept Policy (only if Phase 1 succeeded) ───────────────
    if (policyKey &amp;&amp; &quot;1&quot; == status) {
        HttpPost hp2 = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=Provision&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)
        hp2.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
        hp2.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
        hp2.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

        ByteArrayOutputStream bao2 = new ByteArrayOutputStream()
        BinarySerializer bs2 = new BinarySerializer(bao2, false)
        bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
          bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
            bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYTYPE,
                              &quot;MS-EAS-Provisioning-WBXML&quot;)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYKEY,
                              policyKey)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_STATUS,
                              &quot;1&quot;)
            bs2.closeTag()
          bs2.closeTag()
        bs2.closeTag()
        hp2.setEntity(new ByteArrayEntity(bao2.toByteArray()))

        HttpResponse hr2  = dhc.execute(hp2)
        long mfaTotal     = System.currentTimeMillis() - mfaStart
        int responseCode2 = hr2.getStatusLine().getStatusCode()
        byte[] resp2      = EntityUtils.toByteArray(hr2.getEntity())
        String finalPolicyKey = &quot;&quot;

        if (responseCode2 == 200 &amp;&amp; resp2.length &gt; 0) {
            try {
                BinaryParser bp2 = new BinaryParser(new ByteArrayInputStream(resp2), false)
                boolean inPK     = false
                while (bp2.next() != null) {
                    switch (bp2.getEventType()) {
                        case BinaryParser.START_TAG:
                            result.append(&quot;&lt;${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = true
                            break
                        case BinaryParser.END_TAG:
                            result.append(&quot;&lt;/${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = false
                            break
                        case BinaryParser.TEXT:
                            String text2 = bp2.getText()
                            result.append(text2)
                            if (inPK) finalPolicyKey = text2
                            break
                    }
                }
            } catch (IOException e) {
                if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
            }
        }

        // ── Store in props (namespaced) for cross-thread reads ────────────
        // Store in vars (thread-local) for same-thread downstream samplers
        if (finalPolicyKey) {
            props.put(&quot;FINAL_POLICY_KEY.${userKey}&quot;, finalPolicyKey)
            vars.put(&quot;FINAL_POLICY_KEY&quot;, finalPolicyKey)
            log.info(&quot;Provision Phase2: HTTP=${responseCode2} | FinalPolicyKey=${finalPolicyKey} | MFA_Total=${mfaTotal}ms | User=${userKey}&quot;)
        } else {
            log.warn(&quot;Provision Phase2: FinalPolicyKey not found in response | HTTP=${responseCode2} | User=${userKey}&quot;)
        }

        vars.put(&quot;MFA_LATENCY_TOTAL_MS&quot;, String.valueOf(mfaTotal))
    } else {
        log.warn(&quot;Provision Phase2 skipped: policyKey=&apos;${policyKey}&apos; | status=&apos;${status}&apos; | User=${userKey}&quot;)
    }

    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-RefreshToken-Provision&quot;)
    dhc.close()

} catch (Exception e) {
    log.error(&quot;Provision: ${e.toString()}&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="ColdAuth_InitialSync" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.HttpEntity
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import org.apache.commons.lang3.StringEscapeUtils
import java.nio.charset.StandardCharsets
import java.util.regex.Matcher
import java.util.regex.Pattern
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP Request ────────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=Sync&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    // ── PolicyKey: props-first read (persists across iterations) ─────────
    // props written by Provision sampler; vars fallback for same-iteration use
    String policyKey = props.getProperty(&quot;FINAL_POLICY_KEY.${userKey}&quot;, vars.get(&quot;FINAL_POLICY_KEY&quot;) ?: &quot;0&quot;) ?: &quot;0&quot;
    hp.setHeader(&quot;X-MS-PolicyKey&quot;, policyKey)
    log.info(&quot;S-InitialSync: using PolicyKey=${policyKey} | SyncKey=0 (cold start) | User=${userKey}&quot;)

    // ── Generate WBXML Request Body ───────────────────────────────────────
    // InitialSync always starts with SyncKey=0
    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_SYNC)
      bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_COLLECTIONS)
        bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_COLLECTION)
          bs.textElement(BinarySerializer.NAMESPACE_AIRSYNC,
                         BinarySerializer.AIRSYNC_SYNCKEY, &quot;0&quot;)
          bs.integerElement(BinarySerializer.NAMESPACE_AIRSYNC,
                            BinarySerializer.AIRSYNC_COLLECTIONID, 2)
        bs.closeTag()
      bs.closeTag()
    bs.closeTag()

    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // ── SSL + Execute ─────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    HttpResponse hr        = dhc.execute(hp)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Parse WBXML Response ──────────────────────────────────────────────
    StringBuilder result = new StringBuilder()
    boolean inSyncKey    = false
    String nextSyncKey   = &quot;&quot;

    try {
        BinaryParser bp = new BinaryParser(
            new ByteArrayInputStream(EntityUtils.toByteArray(hr.getEntity())), false)

        while (bp.next() != null) {
            switch (bp.getEventType()) {
                case BinaryParser.START_DOCUMENT:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.END_DOCUMENT:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.START_TAG:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = true
                    break
                case BinaryParser.END_TAG:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = false
                    break
                case BinaryParser.TEXT:
                    String text = bp.getText()?.replaceAll(&quot;\\p{Cntrl}&quot;, &quot;&quot;) ?: &quot;&quot;
                    result.append(StringEscapeUtils.escapeXml(text))
                    if (inSyncKey &amp;&amp; text?.trim()) {
                        nextSyncKey = text.trim()
                    }
                    break
            }
        }
    } catch (IOException e) {
        if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
    }

    // ── Fallback: regex extract SyncKey if BinaryParser missed it ─────────
    if (!nextSyncKey) {
        Matcher m = Pattern.compile(&quot;&lt;SyncKey&gt;([^&lt;]+)&lt;/SyncKey&gt;&quot;).matcher(result.toString())
        if (m.find()) {
            nextSyncKey = m.group(1).trim()
            log.info(&quot;S-InitialSync: SyncKey extracted via regex fallback | SyncKey=${nextSyncKey} | User=${userKey}&quot;)
        }
    }

    // ── Store SyncKey in props (cross-iteration) + vars (same-iteration) ──
    // props write is critical: CachedAuth_DeltaSync reads SYNCSYNCKEY.${userKey}
    // from props — if only written to vars, DeltaSync chain cannot advance
    if (nextSyncKey) {
        props.put(&quot;SYNCSYNCKEY.${userKey}&quot;, nextSyncKey)
        vars.put(&quot;SYNCSYNCKEY&quot;, nextSyncKey)
        log.info(&quot;S-InitialSync: stored SYNCSYNCKEY=${nextSyncKey} | HTTP=${responseCode} | PolicyKey=${policyKey} | User=${userKey}&quot;)
    } else {
        log.warn(&quot;S-InitialSync: no SyncKey found in response | HTTP=${responseCode} | PolicyKey=${policyKey} | result=${result.toString().take(200)} | User=${userKey}&quot;)
    }

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-S3-ColdAuth-InitialSync&quot;)

} catch (Exception e) {
    log.error(&quot;S-InitialSync: ${e.toString()}&quot;)
}</stringProp>
