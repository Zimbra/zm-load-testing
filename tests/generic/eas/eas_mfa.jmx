        </hashTree>
        <ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="20% — Refresh Token" enabled="true">
          <intProp name="ThroughputController.style">1</intProp>
          <boolProp name="ThroughputController.perThread">false</boolProp>
          <intProp name="ThroughputController.maxThroughput">1</intProp>
          <FloatProperty>
            <name>ThroughputController.percentThroughput</name>
            <value>20.0</value>
            <savedValue>0.0</savedValue>
          </FloatProperty>
        </ThroughputController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="RefreshToken-Provision" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Shared auth header (reused across Phase 1 + Phase 2) ─────────────
    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    String authHeader  = &quot;Basic ${new String(encodedAuth)}&quot;
    String easVersion  = props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;)
    String baseUrl     = &quot;${vars.get(&apos;URL&apos;)}?Cmd=Provision&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;

    // ── SSL client (shared across Phase 1 + Phase 2) ──────────────────────
    SSLContextBuilder sslBuilder = new SSLContextBuilder()
    sslBuilder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        sslBuilder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    // ════════════════════════════════════════════════════════════════════════
    // Phase 1: Get Policy
    // ════════════════════════════════════════════════════════════════════════
    HttpPost hp = new HttpPost(baseUrl)
    hp.setHeader(HttpHeaders.AUTHORIZATION, authHeader)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, easVersion)

    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
      bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
        bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
          bs.textElement(BinarySerializer.NAMESPACE_PROVISION,
                         BinarySerializer.PROVISION_POLICYTYPE,
                         &quot;MS-EAS-Provisioning-WBXML&quot;)
        bs.closeTag()
      bs.closeTag()
    bs.closeTag()
    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    long mfaStart  = System.currentTimeMillis()
    HttpResponse hr = dhc.execute(hp)
    long mfaPhase1 = System.currentTimeMillis() - mfaStart

    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    String policyKey     = &quot;&quot;
    String status        = &quot;&quot;
    StringBuilder result = new StringBuilder()
    byte[] respBytes     = EntityUtils.toByteArray(hr.getEntity())

    if (responseCode == 200 &amp;&amp; respBytes.length &gt; 0) {
        try {
            BinaryParser bp     = new BinaryParser(new ByteArrayInputStream(respBytes), false)
            boolean inPolicyKey = false
            boolean inStatus    = false

            while (bp.next() != null) {
                switch (bp.getEventType()) {
                    case BinaryParser.START_TAG:
                        result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = true
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = true
                        break
                    case BinaryParser.END_TAG:
                        result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = false
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = false
                        break
                    case BinaryParser.TEXT:
                        String text = bp.getText()
                        result.append(text)
                        if (inPolicyKey) policyKey = text
                        if (inStatus)    status    = text
                        break
                }
            }
        } catch (IOException e) {
            if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
        }
    } else {
        result.append(new String(respBytes, StandardCharsets.UTF_8))
    }

    vars.put(&quot;PROVISION_POLICY_KEY&quot;,  policyKey)
    vars.put(&quot;PROVISION_STATUS&quot;,      status)
    vars.put(&quot;MFA_LATENCY_PHASE1_MS&quot;, String.valueOf(mfaPhase1))

    log.info(&quot;RefreshToken-Provision Phase1: HTTP=${responseCode} | PolicyKey=${policyKey} | Status=${status} | MFA_Phase1=${mfaPhase1}ms | User=${userKey}&quot;)

    // ════════════════════════════════════════════════════════════════════════
    // Phase 2: Accept Policy (only if Phase 1 succeeded)
    // ════════════════════════════════════════════════════════════════════════
    if (policyKey &amp;&amp; &quot;1&quot; == status) {

        HttpPost hp2 = new HttpPost(baseUrl)
        hp2.setHeader(HttpHeaders.AUTHORIZATION, authHeader)
        hp2.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
        hp2.setHeader(&quot;MS-ASProtocolVersion&quot;, easVersion)

        ByteArrayOutputStream bao2 = new ByteArrayOutputStream()
        BinarySerializer bs2 = new BinarySerializer(bao2, false)
        bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
          bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
            bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYTYPE,
                              &quot;MS-EAS-Provisioning-WBXML&quot;)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYKEY,
                              policyKey)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_STATUS,
                              &quot;1&quot;)
            bs2.closeTag()
          bs2.closeTag()
        bs2.closeTag()
        hp2.setEntity(new ByteArrayEntity(bao2.toByteArray()))

        HttpResponse hr2  = dhc.execute(hp2)
        long mfaTotal     = System.currentTimeMillis() - mfaStart
        int responseCode2 = hr2.getStatusLine().getStatusCode()
        byte[] resp2      = EntityUtils.toByteArray(hr2.getEntity())
        String finalPolicyKey = &quot;&quot;

        if (responseCode2 == 200 &amp;&amp; resp2.length &gt; 0) {
            try {
                BinaryParser bp2 = new BinaryParser(new ByteArrayInputStream(resp2), false)
                boolean inPK     = false

                while (bp2.next() != null) {
                    switch (bp2.getEventType()) {
                        case BinaryParser.START_TAG:
                            result.append(&quot;&lt;${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = true
                            break
                        case BinaryParser.END_TAG:
                            result.append(&quot;&lt;/${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = false
                            break
                        case BinaryParser.TEXT:
                            String text2 = bp2.getText()
                            result.append(text2)
                            if (inPK) finalPolicyKey = text2
                            break
                    }
                }
            } catch (IOException e) {
                if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
            }
        }

        // ── Store in props (namespaced) + vars (thread-local) ─────────────
        // props.put uses userKey namespace — safe under 300 concurrent users
        // vars.put serves same-thread downstream samplers in this iteration
        if (finalPolicyKey) {
            props.put(&quot;FINAL_POLICY_KEY.${userKey}&quot;, finalPolicyKey)
            vars.put(&quot;FINAL_POLICY_KEY&quot;, finalPolicyKey)
            log.info(&quot;RefreshToken-Provision Phase2: HTTP=${responseCode2} | FinalPolicyKey=${finalPolicyKey} | MFA_Total=${mfaTotal}ms | User=${userKey}&quot;)
        } else {
            log.warn(&quot;RefreshToken-Provision Phase2: FinalPolicyKey not found in response | HTTP=${responseCode2} | User=${userKey}&quot;)
        }

        vars.put(&quot;MFA_LATENCY_TOTAL_MS&quot;, String.valueOf(mfaTotal))

    } else {
        log.warn(&quot;RefreshToken-Provision: skipping Phase2 | policyKey=&apos;${policyKey}&apos; | status=&apos;${status}&apos; | User=${userKey}&quot;)
    }

    // ── Reset SyncKey state so downstream DeltaSync picks up fresh chain ──
    // Namespaced removes — only clears THIS user&apos;s state, not all 300 users
    props.remove(&quot;SYNCSYNCKEY.${userKey}&quot;)
    props.remove(&quot;DELTASYNCSYNCKEY.${userKey}&quot;)
    props.remove(&quot;FOLDERSYNCKEY.${userKey}&quot;)
    log.info(&quot;RefreshToken-Provision: cleared SyncKey state for fresh chain | User=${userKey}&quot;)

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-RefreshToken-Provision&quot;)

} catch (Exception e) {
    log.error(&quot;RefreshToken-Provision: ${e.toString()}&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="RefreshToken-FolderSync" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.HttpEntity
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP Request ────────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=FolderSync&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    // ── PolicyKey + FolderSyncKey: per-user namespaced reads ──────────────
    // After RefreshToken-Provision clears FOLDERSYNCKEY, this defaults to &quot;0&quot;
    // so the device re-syncs folder hierarchy from scratch after token refresh.
    String policyKey     = props.getProperty(&quot;FINAL_POLICY_KEY.${userKey}&quot;, &quot;0&quot;) ?: &quot;0&quot;
    String folderSyncKey = props.getProperty(&quot;FOLDERSYNCKEY.${userKey}&quot;, &quot;0&quot;) ?: &quot;0&quot;

    hp.setHeader(&quot;X-MS-PolicyKey&quot;, policyKey)
    log.info(&quot;RefreshToken-FolderSync: using PolicyKey=${policyKey} | FolderSyncKey=${folderSyncKey} | User=${userKey}&quot;)

    // ── Generate WBXML Request Body ───────────────────────────────────────
    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
               BinarySerializer.FOLDERHIERARCHY_FOLDERSYNC)
      bs.textElement(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
                     BinarySerializer.FOLDERHIERARCHY_SYNCKEY,
                     folderSyncKey)
    bs.closeTag()

    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // ── SSL + Execute ─────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    HttpResponse hr        = dhc.execute(hp)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Parse WBXML Response + Extract FolderSyncKey ─────────────────────
    StringBuilder result = new StringBuilder()
    String nextSyncKey   = &quot;&quot;
    boolean inSyncKey    = false

    try {
        BinaryParser bp = new BinaryParser(
            new ByteArrayInputStream(EntityUtils.toByteArray(hr.getEntity())), false)

        while (bp.next() != null) {
            switch (bp.getEventType()) {
                case BinaryParser.START_DOCUMENT:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.END_DOCUMENT:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.START_TAG:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = true
                    break
                case BinaryParser.END_TAG:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = false
                    break
                case BinaryParser.TEXT:
                    String text = bp.getText()
                    result.append(text)
                    if (inSyncKey &amp;&amp; text?.trim()) {
                        nextSyncKey = text.trim()
                    }
                    break
            }
        }
    } catch (IOException e) {
        if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
    }

    // ── Store refreshed FolderSyncKey in props for next call ──────────────
    if (nextSyncKey) {
        props.put(&quot;FOLDERSYNCKEY.${userKey}&quot;, nextSyncKey)
        vars.put(&quot;FOLDERSYNCKEY&quot;, nextSyncKey)
        log.info(&quot;RefreshToken-FolderSync: next SyncKey=${nextSyncKey} | HTTP=${responseCode} | User=${userKey}&quot;)
    } else if (responseCode == 200) {
        log.warn(&quot;RefreshToken-FolderSync: HTTP=200 but no SyncKey extracted (malformed response?) | PolicyKey=${policyKey} | User=${userKey}&quot;)
    } else {
        log.warn(&quot;RefreshToken-FolderSync: HTTP=${responseCode} ${responseMessage} | PolicyKey sent=${policyKey} | FolderSyncKey sent=${folderSyncKey} | User=${userKey}&quot;)
    }

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-RefreshToken-FolderSync&quot;)

} catch (Exception e) {
    log.error(&quot;RefreshToken-FolderSync: ${e.toString()}&quot;)
}</stringProp>
