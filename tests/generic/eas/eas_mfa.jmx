        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Cached-Auth-Sanity" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">false</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="START" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import com.zimbra.jmeter.Zimbra
import com.zimbra.jmeter.Command

// ── Build EAS URL ──────────────────────────────────────────────────────────────
String protocol = props.get(&quot;HTTP.protocol&quot;)
String server   = props.get(&quot;HTTP.server&quot;)
String port     = props.get(&quot;HTTP.port&quot;)

String url = &quot;${protocol}://${server}&quot;
if (port != null &amp;&amp; !port.trim().isEmpty()) {
    url = &quot;${url}:${port}&quot;
}
url = &quot;${url}/Microsoft-Server-ActiveSync&quot;
vars.put(&quot;URL&quot;, url)
// log.info(&quot;EAS URL: ${url}&quot;)

// ── Initialize EAS object and store in vars ────────────────────────────────────
Zimbra eas = new Zimbra(props, &quot;EAS&quot;)
vars.putObject(&quot;EAS&quot;, eas)

// ── Retrieve commands list ─────────────────────────────────────────────────────
ArrayList commands = eas.getcommands()
vars.putObject(&quot;COMMANDS&quot;, commands)

// ── Calculate per-command DELAY ────────────────────────────────────────────────
String userDuration = props.get(&quot;LOAD.EAS.userduration&quot;)
if (userDuration == null || commands.size() == 0) {
    vars.putObject(&quot;DELAY&quot;, &quot;0&quot;)
} else {
    int delay = (Integer.parseInt(userDuration) * 1000) / commands.size()
    vars.putObject(&quot;DELAY&quot;, delay.toString())
}

// ── Initialize CONTINUE flag ───────────────────────────────────────────────────
vars.put(&quot;CONTINUE&quot;, commands.size() &gt; 0 ? &quot;true&quot; : &quot;false&quot;)

// ── Initialize sync keys and folder name ──────────────────────────────────────
vars.put(&quot;FOLDERSYNCKEY&quot;, &quot;0&quot;)
vars.put(&quot;SYNCSYNCKEY&quot;,   &quot;0&quot;)
vars.put(&quot;FOLDERNAME&quot;,    &quot;TestDir${org.apache.commons.lang3.RandomUtils.nextInt(1, 10001)}&quot;)
vars.put(&quot;MOREAVAILABLE&quot;, &quot;true&quot;)</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Run_Commands" enabled="true">
            <stringProp name="WhileController.condition">${__BeanShell(&quot;${CONTINUE}&quot;.equals(&quot;true&quot;))}</stringProp>
          </WhileController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Next_Command" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import com.zimbra.jmeter.Command

// ── Retrieve commands list from vars ──────────────────────────────────────────
ArrayList commands = vars.getObject(&quot;COMMANDS&quot;)

// ── Process next command if available ─────────────────────────────────────────
if (commands.size() &gt; 0) {
    // log.info(&quot;Testing: ${commands}&quot;)

    Command c = commands.remove(0)
    vars.put(&quot;COMMAND&quot;, c.getName())

    // ── Map command arguments into JMeter vars ─────────────────────────────────
    for (Map.Entry entry : c.argsSet()) {
        vars.put(entry.getKey(), entry.getValue())
    }

    // log.info(&quot;COMMAND: ${vars.get(&apos;COMMAND&apos;)}&quot;)
}

// ── Update CONTINUE flag ───────────────────────────────────────────────────────
if (commands.size() == 0) {
    vars.put(&quot;CONTINUE&quot;, &quot;false&quot;)
}</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
          <SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="Commands" enabled="true">
            <stringProp name="SwitchController.value">${COMMAND}</stringProp>
          </SwitchController>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Command Delay" enabled="true">
              <stringProp name="ConstantTimer.delay">${DELAY}</stringProp>
            </ConstantTimer>
            <hashTree/>
          </hashTree>
          <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once Only Controller" enabled="true"/>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Options" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpOptions
import org.apache.http.HttpResponse
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP OPTIONS Request ────────────────────────────────────────
    HttpOptions ho = new HttpOptions(vars.get(&quot;URL&quot;))

    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    ho.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    ho.setHeader(&quot;User-Agent&quot;, &quot;Apple-iPhone9C1/1604.1&quot;)
    ho.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    // ── SSL ───────────────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    // ── Execute ───────────────────────────────────────────────────────────
    HttpResponse hr        = dhc.execute(ho)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Capture EAS capability headers ────────────────────────────────────
    String cmds     = &quot;&quot;
    String versions = &quot;&quot;
    for (org.apache.http.Header h : hr.getAllHeaders()) {
        if (&quot;MS-ASProtocolCommands&quot; == h.getName()) cmds     = h.getValue()
        if (&quot;MS-ASProtocolVersions&quot; == h.getName()) versions = h.getValue()
    }

    // ── Store in vars (thread-local) + props (namespaced + global) ────────
    // vars  → downstream samplers in this thread/iteration
    // props namespaced → per-user capability reads across thread groups
    // props global     → EAS.version negotiation consumed by all samplers
    vars.put(&quot;EAS_SUPPORTED_COMMANDS&quot;, cmds)
    vars.put(&quot;EAS_SUPPORTED_VERSIONS&quot;, versions)
    props.put(&quot;EAS_SUPPORTED_COMMANDS.${userKey}&quot;, cmds)
    props.put(&quot;EAS_SUPPORTED_VERSIONS.${userKey}&quot;, versions)

    // ── Negotiate EAS version: prefer 16.1, fall back to 14.1, else 12.1 ─
    // Writes props[&quot;EAS.version&quot;] — consumed by all samplers via
    // props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;) with no further changes needed
    if (versions.contains(&quot;16.1&quot;)) {
        props.put(&quot;EAS.version&quot;, &quot;16.1&quot;)
    } else if (versions.contains(&quot;14.1&quot;)) {
        props.put(&quot;EAS.version&quot;, &quot;14.1&quot;)
    } else {
        props.put(&quot;EAS.version&quot;, &quot;12.1&quot;)
    }

    // ── Validate 16.1 is advertised ───────────────────────────────────────
    if (!versions.contains(&quot;16.1&quot;)) {
        log.warn(&quot;S2-OPTIONS: server does not advertise EAS 16.1 | Versions=${versions} | User=${userKey}&quot;)
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&quot;EAS 16.1 not advertised by server&quot;)
    } else {
        SampleResult.setSuccessful(true)
    }

    dhc.close()
    SampleResult.setResponseData(&quot;Commands: ${cmds}\nVersions: ${versions}&quot;, &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-S2-OPTIONS&quot;)

    log.info(&quot;S2-OPTIONS: HTTP=${responseCode} | Versions=${versions} | NegotiatedVersion=${props.getProperty(&apos;EAS.version&apos;)} | Commands=${cmds} | User=${userKey}&quot;)

} catch (Exception e) {
    log.error(&quot;S2-OPTIONS: ${e.toString()}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Sampler>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Provision" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Shared auth + config (reused across Phase 1 + Phase 2) ───────────
    String auth        = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    String authHeader  = &quot;Basic ${new String(encodedAuth)}&quot;
    String easVersion  = props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;)
    String baseUrl     = &quot;${vars.get(&apos;URL&apos;)}?Cmd=Provision&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;

    // ── SSL client (shared across Phase 1 + Phase 2) ──────────────────────
    SSLContextBuilder sslBuilder = new SSLContextBuilder()
    sslBuilder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        sslBuilder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    // ════════════════════════════════════════════════════════════════════════
    // Phase 1: Get Policy
    // ════════════════════════════════════════════════════════════════════════
    HttpPost hp = new HttpPost(baseUrl)
    hp.setHeader(HttpHeaders.AUTHORIZATION, authHeader)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, easVersion)

    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
      bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
        bs.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
          bs.textElement(BinarySerializer.NAMESPACE_PROVISION,
                         BinarySerializer.PROVISION_POLICYTYPE,
                         &quot;MS-EAS-Provisioning-WBXML&quot;)
        bs.closeTag()
      bs.closeTag()
    bs.closeTag()
    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // Track MFA latency — this request triggers the MFA flow server-side
    long mfaStart  = System.currentTimeMillis()
    HttpResponse hr = dhc.execute(hp)
    long mfaPhase1 = System.currentTimeMillis() - mfaStart

    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    String policyKey     = &quot;&quot;
    String status        = &quot;&quot;
    StringBuilder result = new StringBuilder()
    byte[] respBytes     = EntityUtils.toByteArray(hr.getEntity())

    if (responseCode == 200 &amp;&amp; respBytes.length &gt; 0) {
        try {
            BinaryParser bp     = new BinaryParser(new ByteArrayInputStream(respBytes), false)
            boolean inPolicyKey = false
            boolean inStatus    = false
            while (bp.next() != null) {
                switch (bp.getEventType()) {
                    case BinaryParser.START_TAG:
                        result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = true
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = true
                        break
                    case BinaryParser.END_TAG:
                        result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                        if (&quot;PolicyKey&quot; == bp.getName()) inPolicyKey = false
                        if (&quot;Status&quot;    == bp.getName()) inStatus    = false
                        break
                    case BinaryParser.TEXT:
                        String text = bp.getText()
                        result.append(text)
                        if (inPolicyKey) policyKey = text
                        if (inStatus)    status    = text
                        break
                }
            }
        } catch (IOException e) {
            if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
        }
    } else {
        result.append(new String(respBytes, StandardCharsets.UTF_8))
    }

    vars.put(&quot;PROVISION_POLICY_KEY&quot;,  policyKey)
    vars.put(&quot;PROVISION_STATUS&quot;,      status)
    vars.put(&quot;MFA_LATENCY_PHASE1_MS&quot;, String.valueOf(mfaPhase1))

    log.info(&quot;S2-Provision Phase1: HTTP=${responseCode} | PolicyKey=${policyKey} | Status=${status} | MFA_Phase1=${mfaPhase1}ms | User=${userKey}&quot;)

    // ════════════════════════════════════════════════════════════════════════
    // Phase 2: Accept Policy (only if Phase 1 succeeded)
    // ════════════════════════════════════════════════════════════════════════
    if (policyKey &amp;&amp; &quot;1&quot; == status) {

        HttpPost hp2 = new HttpPost(baseUrl)
        hp2.setHeader(HttpHeaders.AUTHORIZATION, authHeader)
        hp2.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
        hp2.setHeader(&quot;MS-ASProtocolVersion&quot;, easVersion)

        ByteArrayOutputStream bao2 = new ByteArrayOutputStream()
        BinarySerializer bs2 = new BinarySerializer(bao2, false)
        bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_PROVISION)
          bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICIES)
            bs2.openTag(BinarySerializer.NAMESPACE_PROVISION, BinarySerializer.PROVISION_POLICY)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYTYPE,
                              &quot;MS-EAS-Provisioning-WBXML&quot;)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_POLICYKEY,
                              policyKey)
              bs2.textElement(BinarySerializer.NAMESPACE_PROVISION,
                              BinarySerializer.PROVISION_STATUS,
                              &quot;1&quot;)
            bs2.closeTag()
          bs2.closeTag()
        bs2.closeTag()
        hp2.setEntity(new ByteArrayEntity(bao2.toByteArray()))

        HttpResponse hr2  = dhc.execute(hp2)
        long mfaTotal     = System.currentTimeMillis() - mfaStart
        int responseCode2 = hr2.getStatusLine().getStatusCode()
        byte[] resp2      = EntityUtils.toByteArray(hr2.getEntity())
        String finalPolicyKey = &quot;&quot;

        if (responseCode2 == 200 &amp;&amp; resp2.length &gt; 0) {
            try {
                BinaryParser bp2 = new BinaryParser(new ByteArrayInputStream(resp2), false)
                boolean inPK     = false
                while (bp2.next() != null) {
                    switch (bp2.getEventType()) {
                        case BinaryParser.START_TAG:
                            result.append(&quot;&lt;${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = true
                            break
                        case BinaryParser.END_TAG:
                            result.append(&quot;&lt;/${bp2.getName()}&gt;&quot;)
                            if (&quot;PolicyKey&quot; == bp2.getName()) inPK = false
                            break
                        case BinaryParser.TEXT:
                            String text2 = bp2.getText()
                            result.append(text2)
                            if (inPK) finalPolicyKey = text2
                            break
                    }
                }
            } catch (IOException e) {
                if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
            }
        }

        // ── Store in props (namespaced) + vars (thread-local) ─────────────
        // props persists across iterations for LoopController(10) downstream
        // vars serves same-iteration FolderSync/InitialSync in same thread
        if (finalPolicyKey) {
            props.put(&quot;FINAL_POLICY_KEY.${userKey}&quot;, finalPolicyKey)
            vars.put(&quot;FINAL_POLICY_KEY&quot;, finalPolicyKey)
            log.info(&quot;S2-Provision Phase2: HTTP=${responseCode2} | FinalPolicyKey=${finalPolicyKey} | MFA_Total=${mfaTotal}ms | User=${userKey}&quot;)
        } else {
            log.warn(&quot;S2-Provision Phase2: FinalPolicyKey not found in response | HTTP=${responseCode2} | User=${userKey}&quot;)
        }

        vars.put(&quot;MFA_LATENCY_TOTAL_MS&quot;, String.valueOf(mfaTotal))

    } else {
        log.warn(&quot;S2-Provision: skipping Phase2 | policyKey=&apos;${policyKey}&apos; | status=&apos;${status}&apos; | User=${userKey}&quot;)
    }

    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-S2-Provision&quot;)
    dhc.close()

} catch (Exception e) {
    log.error(&quot;S2-Provision: ${e.toString()}&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Cached auth - no MFA" enabled="true">
            <boolProp name="TransactionController.includeTimers">false</boolProp>
            <boolProp name="TransactionController.parent">false</boolProp>
          </TransactionController>
          <hashTree>
            <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
              <intProp name="LoopController.loops">-1</intProp>
            </LoopController>
            <hashTree>
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="default" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">log.info(&quot;${Thread.currentThread().getName()} ${vars.get(&apos;COMMAND&apos;)} not currently supported&quot;)</stringProp>
              </JSR223Sampler>
              <hashTree/>
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="FolderSync" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.HttpEntity
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP Request ────────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=${vars.get(&apos;COMMAND&apos;)}&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;16.1&quot;))

    // ── Generate WBXML Request Body ───────────────────────────────────────
    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
               BinarySerializer.FOLDERHIERARCHY_FOLDERSYNC)
      bs.textElement(BinarySerializer.NAMESPACE_FOLDERHIERARCHY,
                     BinarySerializer.FOLDERHIERARCHY_SYNCKEY,
                     vars.get(&quot;FOLDERSYNCKEY&quot;))
    bs.closeTag()

    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // ── SSL + Execute ─────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    HttpResponse hr = dhc.execute(hp)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Parse WBXML + Convert to readable form for JMeter ─────────────────
    StringBuilder result = new StringBuilder()
    boolean inSyncKey    = false

    try {
        BinaryParser bp = new BinaryParser(
            new ByteArrayInputStream(EntityUtils.toByteArray(hr.getEntity())), false)

        while (bp.next() != null) {
            switch (bp.getEventType()) {
                case BinaryParser.START_DOCUMENT:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.END_DOCUMENT:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.START_TAG:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = true
                    break
                case BinaryParser.END_TAG:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = false
                    break
                case BinaryParser.TEXT:
                    String text = bp.getText()
                    result.append(text)
                    if (inSyncKey &amp;&amp; text?.trim()) {
                        vars.put(&quot;FOLDERSYNCKEY&quot;, text.trim())
                        log.info(&quot;FolderSync: next SyncKey=${text.trim()} | HTTP=${responseCode} | User=${userKey}&quot;)
                    }
                    break
            }
        }
    } catch (IOException e) {
        if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
    }

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-FolderSync&quot;)

} catch (Exception e) {
    log.error(&quot;FolderSync: ${e.toString()}&quot;)
}</stringProp>
              </JSR223Sampler>
              <hashTree>
                <XPathExtractor guiclass="XPathExtractorGui" testclass="XPathExtractor" testname="XPath Extractor" enabled="true">
                  <stringProp name="XPathExtractor.default">${FOLDERSYNCKEY}</stringProp>
                  <stringProp name="XPathExtractor.refname">FOLDERSYNCKEY</stringProp>
                  <stringProp name="XPathExtractor.xpathQuery">//SyncKey</stringProp>
                  <boolProp name="XPathExtractor.validate">false</boolProp>
                  <boolProp name="XPathExtractor.tolerant">false</boolProp>
                  <boolProp name="XPathExtractor.namespace">false</boolProp>
                  <stringProp name="XPathExtractor.matchNumber">-1</stringProp>
                </XPathExtractor>
                <hashTree/>
              </hashTree>
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="InitialSync" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.http.impl.client.HttpClients
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.client.methods.HttpPost
import org.apache.http.HttpResponse
import org.apache.http.HttpEntity
import org.apache.http.entity.ByteArrayEntity
import org.apache.http.conn.ssl.SSLContextBuilder
import org.apache.http.conn.ssl.TrustSelfSignedStrategy
import org.apache.http.conn.ssl.SSLConnectionSocketFactory
import org.apache.http.util.EntityUtils
import org.apache.commons.codec.binary.Base64
import org.apache.commons.lang3.StringEscapeUtils
import java.nio.charset.StandardCharsets
import org.apache.http.HttpHeaders
import org.apache.http.Header
import com.zimbra.zimbrasync.wbxml.BinarySerializer
import com.zimbra.zimbrasync.wbxml.BinaryParser

try {
    // ── Per-user key for props namespacing (multi-user safe) ──────────────
    String userKey = vars.get(&quot;USER&quot;)

    // ── Setup HTTP Request ────────────────────────────────────────────────
    HttpPost hp = new HttpPost(&quot;${vars.get(&apos;URL&apos;)}?Cmd=Sync&amp;User=${userKey}&amp;DeviceId=testing&amp;DeviceType=jmeter&quot;)

    String auth = &quot;${userKey}:${vars.get(&apos;PASS&apos;)}&quot;
    byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1))
    hp.setHeader(HttpHeaders.AUTHORIZATION, &quot;Basic ${new String(encodedAuth)}&quot;)
    hp.setHeader(&quot;Content-Type&quot;, &quot;application/vnd.ms-sync.wbxml&quot;)
    hp.setHeader(&quot;MS-ASProtocolVersion&quot;, props.getProperty(&quot;EAS.version&quot;, &quot;12.1&quot;))

    // ── Generate WBXML Request Body ───────────────────────────────────────
    ByteArrayOutputStream bao = new ByteArrayOutputStream()
    BinarySerializer bs = new BinarySerializer(bao, false)
    bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_SYNC)
      bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_COLLECTIONS)
        bs.openTag(BinarySerializer.NAMESPACE_AIRSYNC, BinarySerializer.AIRSYNC_COLLECTION)
          bs.textElement(BinarySerializer.NAMESPACE_AIRSYNC,
                         BinarySerializer.AIRSYNC_SYNCKEY,
                         vars.get(&quot;SYNCSYNCKEY&quot;))
          bs.integerElement(BinarySerializer.NAMESPACE_AIRSYNC,
                            BinarySerializer.AIRSYNC_COLLECTIONID, 2)
        bs.closeTag()
      bs.closeTag()
    bs.closeTag()

    hp.setEntity(new ByteArrayEntity(bao.toByteArray()))

    // ── SSL + Execute ─────────────────────────────────────────────────────
    SSLContextBuilder builder = new SSLContextBuilder()
    builder.loadTrustMaterial(null, new TrustSelfSignedStrategy())
    SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(
        builder.build(), SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER)
    CloseableHttpClient dhc = HttpClients.custom().setSSLSocketFactory(sslsf).build()

    HttpResponse hr = dhc.execute(hp)
    int responseCode       = hr.getStatusLine().getStatusCode()
    String responseMessage = hr.getStatusLine().getReasonPhrase()

    // ── Debug: log response headers (uncomment to enable) ─────────────────
    // hr.getAllHeaders().each { Header h -&gt;
    //     log.info(&quot;Header: ${h.getName()}=${h.getValue()}&quot;)
    // }

    // ── Parse WBXML + Convert to readable form for JMeter ─────────────────
    StringBuilder result = new StringBuilder()
    boolean inSyncKey    = false

    try {
        BinaryParser bp = new BinaryParser(
            new ByteArrayInputStream(EntityUtils.toByteArray(hr.getEntity())), false)

        while (bp.next() != null) {
            switch (bp.getEventType()) {
                case BinaryParser.START_DOCUMENT:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.END_DOCUMENT:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    break
                case BinaryParser.START_TAG:
                    result.append(&quot;&lt;${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = true
                    break
                case BinaryParser.END_TAG:
                    result.append(&quot;&lt;/${bp.getName()}&gt;&quot;)
                    if (&quot;SyncKey&quot; == bp.getName()) inSyncKey = false
                    break
                case BinaryParser.TEXT:
                    String text = bp.getText()
                    // Preserve control-char sanitisation + XML escape
                    text = text.replaceAll(&quot;\\p{Cntrl}&quot;, &quot;&quot;)
                    result.append(StringEscapeUtils.escapeXml(text))
                    if (inSyncKey &amp;&amp; text?.trim()) {
                        vars.put(&quot;SYNCSYNCKEY&quot;, text.trim())
                        log.info(&quot;Sync: next SyncKey=${text.trim()} | HTTP=${responseCode} | User=${userKey}&quot;)
                    }
                    break
            }
        }
    } catch (IOException e) {
        if (e.getMessage() != &quot;Unexpected EOF&quot;) throw e
    }

    dhc.close()
    SampleResult.setResponseData(result.toString(), &quot;UTF-8&quot;)
    SampleResult.setSampleLabel(&quot;TC-Sync&quot;)

} catch (Exception e) {
    log.error(&quot;Sync: ${e.toString()}&quot;)
}</stringProp>
